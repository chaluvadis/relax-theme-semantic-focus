{
  "name": "relaxed-theme-semantic-focus",
  "displayName": "Relaxed Theme - Semantic Focus",
  "description": "A calm, readable theme family for Visual Studio Code with first‑class semantic highlighting and complete modern UI coverage. Tuned for TypeScript/JavaScript and C# (.NET)",
  "version": "0.0.15",
  "publisher": "nomad-in-code",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaluvadis/relax-theme-semantic-focus.git"
  },
  "bugs": {
    "url": "https://github.com/chaluvadis/relax-theme-semantic-focus/issues"
  },
  "homepage": "https://github.com/chaluvadis/relax-theme-semantic-focus#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "typescript": "^7.0.2",
    "@vscode/vsce": "^3.9.2"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "VSCode",
    "Themes",
    "Relaxed",
    "theme",
    "dark theme",
    "light theme",
    "semantic highlighting",
    "typescript",
    "javascript",
    "python",
    "csharp",
    ".net",
    "low eye strain",
    "accessibility",
    "modern ui",
    "terminal colors",
    "testing colors",
    "debug colors",
    "git decorations",
    "bracket pair colorization",
    "inlay hints",
    "diff editor",
    "minimap",
    "merge editor",
    "chat colors",
    "scm graph",
    "complete coverage"
  ],
  "galleryBanner": {
    "color": "#2b2f34",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Relaxed Theme - Dark Focus (Semantic)",
        "uiTheme": "vs-dark",
        "path": "./themes/relaxed-theme-semantic-dark-focus.json"
      },
      {
        "label": "Relaxed Theme - Night Warm (Semantic)",
        "uiTheme": "vs-dark",
        "path": "./themes/relaxed-theme-semantic-night-warm.json"
      },
      {
        "label": "Relaxed Theme - Day Light (Semantic)",
        "uiTheme": "vs",
        "path": "./themes/relaxed-theme-semantic-day-light.json"
      }
    ],
    "configurationDefaults": {
      "window.autoDetectColorScheme": true,
      "workbench.preferredDarkColorTheme": "Relaxed Theme - Dark Focus (Semantic)",
      "workbench.preferredLightColorTheme": "Relaxed Theme - Day Light (Semantic)",
      "editor.semanticHighlighting.enabled": true,
      "[yaml]": {
        "editor.formatOnSave": false,
        "editor.autoIndent": "advanced"
      },
      "[helm]": {
        "editor.formatOnSave": false,
        "editor.autoIndent": "advanced"
      }
    }
  },
  "license": "MIT",
  "extensionKind": [
    "ui"
  ]
}